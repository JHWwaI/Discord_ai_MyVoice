DISCORD_BOT_TOKEN=your_discord_bot_token_here

# TTS 기본 설정
TTS_VOICE_DEFAULT=ko-KR-SunHiNeural
TTS_SPEED_DEFAULT=+0%

# 경로
TEMP_DIR=temp
DB_PATH=voicebridge.db

# Idle timeout (초)
IDLE_TIMEOUT=60

# 8단계: Kaggle XTTS v2 서버 URL (ngrok으로 생성된 URL)
CLONED_VOICE_URL=https://xxxx-xx-xx-xx-xx.ngrok-free.app

# 9단계: Discord 에러 알림 웹훅 URL (선택)
ERROR_WEBHOOK_URL=https://discord.com/api/webhooks/...
